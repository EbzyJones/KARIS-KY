# ─────────────────────────────────────────────────────────────────────────────
# karis-ky Escrow — Testnet Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# Loaded by `scripts/deploy.sh --env .env.testnet` and
# `scripts/verify_deployment.sh` (for post-deployment checks).
#
# All secrets below are **placeholders**. Replace before use:
#   - SOURCE_SECRET: Stellar secret key (S...) of the funded testnet deployer
#   - DEPLOYER_ADDRESS: Stellar public key (G...) that owns SOURCE_SECRET
#
# Testnet is a public network — never reuse mainnet keys here. Use Stellar
# Laboratory or the Stellar CLI to fund a new identity:
#
#   stellar keys generate deployer-testnet --network testnet --fund
#   stellar keys address deployer-testnet
#
# Schema version: 7 (must match `pub const SCHEMA_VERSION` in escrow/src/lib.rs)
# Interface version: 2
# ─────────────────────────────────────────────────────────────────────────────

# Network identity
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# WASM build target / artifact (used by deploy.sh + verify_deployment.sh)
WASM_TARGET=wasm32v1-none
WASM_PATH=target/${WASM_TARGET}/release/karis_ky_escrow.wasm

# Deployer identity (REPLACE before use — these are placeholders)
SOURCE_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEPLOYER_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Expected init parameters — verify_deployment.sh cross-checks the on-chain
# state against these after deployment. Leave blank to skip that check.
EXPECTED_ADMIN=
EXPECTED_INVOICE_ID=
EXPECTED_FUNDING_TOKEN=
EXPECTED_SCHEMA_VERSION=7