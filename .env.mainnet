# ─────────────────────────────────────────────────────────────────────────────
# karis-ky Escrow — Mainnet Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# Loaded by `scripts/deploy.sh --env .env.mainnet` and
# `scripts/verify_deployment.sh`.
#
# Mainnet is the production environment. **NEVER** reuse a mainnet secret in
# any other environment. Production deployment should source secrets from a
# HSM-backed governance multisig and never store raw secrets in this file
# outside of a secrets manager.
#
# Recommended deployment workflow:
#   1. Update WASM_PATH if a new release tag is being deployed.
#   2. Run scripts/check_wasm_size.py against the new artifact.
#   3. Run scripts/deploy.sh --env .env.mainnet
#   4. Run scripts/verify_deployment.sh with the same env vars and the new
#      CONTRACT_ID returned by step 3.
#   5. Initialize the escrow with the admin multisig (never a single key).
#   6. Record the CONTRACT_ID in docs/MAINNET_INVENTORY.md (or equivalent).
#
# Schema version: 7 (must match `pub const SCHEMA_VERSION` in escrow/src/lib.rs)
# Interface version: 2
# ─────────────────────────────────────────────────────────────────────────────

# Network identity
STELLAR_NETWORK=mainnet
SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org
NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# WASM build target / artifact (used by deploy.sh + verify_deployment.sh)
WASM_TARGET=wasm32v1-none
WASM_PATH=target/${WASM_TARGET}/release/karis_ky_escrow.wasm

# Deployer identity (REPLACE before use — sourced from HSM/multisig in real deploys)
SOURCE_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEPLOYER_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Expected init parameters — verify_deployment.sh cross-checks the on-chain
# state against these after deployment. Leave blank to skip that check.
EXPECTED_ADMIN=
EXPECTED_INVOICE_ID=
EXPECTED_FUNDING_TOKEN=
EXPECTED_SCHEMA_VERSION=7